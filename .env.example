# このファイルを .env.local にコピーして値を入れる（.env.local はコミットしない）
# 値は Supabase 管理画面の Project Settings > API Keys で確認する

# 公開してよい値（ブラウザにも配信される）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 秘密の値（サーバー専用。NEXT_PUBLIC_ を付けないこと）
SUPABASE_SECRET_KEY=

# AIのキー（BYOK）を暗号化する鍵。32バイトをbase64で書く（サーバー専用）
# 作り方：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ENCRYPTION_KEY=
